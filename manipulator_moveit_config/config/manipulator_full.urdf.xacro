<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="manipulator_full">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import manipulator_full urdf file -->
    <xacro:include filename="$(find manipulator_description)/urdf/robot_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="manipulator_full.ros2_control.xacro" />


    <xacro:manipulator_full_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
